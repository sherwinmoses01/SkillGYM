# SkillGYM - Supabase Backend Configuration Template
# Copy this file to .env and fill in your Supabase project credentials:
# 1. Sign up / log in to https://supabase.com
# 2. Create a new project
# 3. Navigate to Project Settings -> API to copy your Project URL and Anon/Public Key

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
