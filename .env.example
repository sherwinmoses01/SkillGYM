# SkillGYM - Backend Configuration Template
# Copy this file to .env and fill in your actual credentials:

# 1. Supabase Database Configuration (https://supabase.com)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 2. JDoodle Compiler API Configuration (https://www.jdoodle.com/compiler-api/)
VITE_JDOODLE_CLIENT_ID=your_jdoodle_client_id_here
VITE_JDOODLE_CLIENT_SECRET=your_jdoodle_client_secret_here
VITE_JDOODLE_API_URL=https://api.jdoodle.com/v1/execute
